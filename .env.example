# ============================================================
# SALIN jadi .env (lokal) / masukkan di Vercel → Settings →
# Environment Variables (jangan pernah commit .env!)
# ============================================================

# --- Google Service Account ---
# Isi string JSON kunci service account dalam SATU baris:
# {"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com", ...}
GOOGLE_CREDENTIALS=

# ID spreadsheet dari URL: docs.google.com/spreadsheets/d/<INI_ID>/edit
SPREADSHEET_ID=

# --- Auth ---
# Kunci rahasia JWT (WAJIB kuat & unik). Contoh generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Akun admin bootstrap (dibuat otomatis saat login pertama jika sheet Users kosong)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiPasswordKuat#2026

# --- Notifikasi Push (opsional; notifikasi dalam aplikasi tetap jalan tanpa ini) ---
# Generate sekali dengan:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontak pengirim push (mailto: atau https://)
VAPID_SUBJECT=mailto:admin@example.com

# --- Pengingat harian (hitung mundur Hari H & agenda) ---
# Rahasia untuk memanggil /api/cron (Vercel Cron & GitHub Actions). Isi string acak panjang:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
# Zona waktu untuk jam pengingat (default Asia/Jakarta = WIB)
APP_TIMEZONE=Asia/Jakarta
