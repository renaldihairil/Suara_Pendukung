# ============================================================
# SALIN jadi .env (lokal) / masukkan di Vercel → Settings →
# Environment Variables (jangan pernah commit .env!)
# ============================================================

# --- Google Service Account ---
# Isi string JSON kunci service account dalam SATU baris:
# {"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com", ...}
GOOGLE_CREDENTIALS=

# ID spreadsheet dari URL: docs.google.com/spreadsheets/d/<INI_ID>/edit
SPREADSHEET_ID=

# --- Auth ---
# Kunci rahasia JWT (WAJIB kuat & unik). Contoh generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Akun admin bootstrap (dibuat otomatis saat login pertama jika sheet Users kosong)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiPasswordKuat#2026

# --- Foto KTP/TTD + baca otomatis KTP (Jembatan Apps Script, lihat README) ---
# URL Web App Apps Script (berakhiran /exec) dan kunci rahasia yang SAMA dengan PGW_KEY di skrip
APPSCRIPT_PHOTO_URL=
APPSCRIPT_PHOTO_KEY=

# (Opsional) cadangan baca KTP gratis: API key dari ocr.space
OCRSPACE_API_KEY=
